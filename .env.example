# =====================================================================
# HR Policy Agent Lab — environment configuration
# Copy to `.env` and fill in before running the agent.
# =====================================================================

# --- Model auth: pick ONE of the two paths below ---------------------

# PATH A — Gemini API key (AI Studio). Simplest. Get one at:
#   https://aistudio.google.com/apikey
# Set ONLY GEMINI_API_KEY (leave GOOGLE_API_KEY unset — setting both makes
# the SDK print a "Both GOOGLE_API_KEY and GEMINI_API_KEY are set" warning).
GEMINI_API_KEY=your_gemini_api_key_here

# PATH B — Vertex AI (use your Google Cloud project + `gcloud auth
# application-default login`). Comment out GEMINI_API_KEY above and uncomment:
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
# GOOGLE_CLOUD_LOCATION=global
# NOTE: For preview models like gemini-3.5-flash on Vertex AI, set
# GOOGLE_CLOUD_LOCATION=global.

GEMINI_MODEL=gemini-3.5-flash

# Judge model for Lab 2 (evals). Ideally a different/stronger model than the agent.
# EVAL_JUDGE_MODEL=gemini-3.5-flash

# --- Retrieval brain: okf | rag | hybrid ----------------------------
#    okf   : traverses the local knowledge/ bundle (NO Google Cloud needed)
#    rag   : queries Vertex AI Search (requires the Track A setup in rag/)
#    hybrid: OKF first, RAG fallback (stretch exercise)
RETRIEVAL_MODE=okf

# --- Vertex AI Search — only for RETRIEVAL_MODE=rag (Track A) --------
GOOGLE_CLOUD_PROJECT=your_gcp_project_id_here
VERTEX_AI_SEARCH_LOCATION=global
VERTEX_AI_DATA_STORE_ID=hr-policies-lab-store
VERTEX_AI_SEARCH_ENGINE_ID=hr-policies-lab-engine
